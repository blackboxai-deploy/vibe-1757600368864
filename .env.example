# Application Configuration
NEXT_PUBLIC_APP_NAME="Audio Video Separator"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# File Upload Configuration
MAX_FILE_SIZE="104857600"
# 100MB in bytes
UPLOAD_DIR="./uploads"
OUTPUT_DIR="./outputs"
TEMP_DIR="./temp"

# Processing Configuration
PROCESSING_TIMEOUT="300000"
# 5 minutes in milliseconds
CLEANUP_INTERVAL="86400000"
# 24 hours in milliseconds
CLEANUP_AFTER_HOURS="24"

# AI Model Configuration (Production)
SPLEETER_MODEL="spleeter:2stems-16kHz"
PYTHON_PATH="/usr/bin/python3"
MODEL_CACHE_DIR="./models"

# Optional: Cloud Storage (AWS S3)
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="us-east-1"
# S3_BUCKET_NAME="audio-separator-files"

# Optional: External API Integration
# For production AI processing
# OPENAI_API_KEY="sk-..."
# REPLICATE_API_TOKEN="r8_..."
# HUGGINGFACE_API_TOKEN="hf_..."

# Optional: Database (for user management and file tracking)
# DATABASE_URL="postgresql://username:password@localhost:5432/audioseparator"
# REDIS_URL="redis://localhost:6379"

# Optional: Email Service (for notifications)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# Optional: Analytics
# GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
# MIXPANEL_TOKEN="your-mixpanel-token"

# Security
# JWT_SECRET="your-jwt-secret-key"
# API_RATE_LIMIT="100"
# API_RATE_WINDOW="900000"
# 15 minutes in milliseconds

# Development
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"